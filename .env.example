# Nenhuma variável é obrigatória: os padrões já apontam para a fonte oficial do TSE.
# Códigos das eleições (resultados.tse.jus.br/oficial/comum/config/ele-c.json)
TSE_ELEICAO_2T=6258
TSE_ELEICAO_1T=6257
TSE_CICLO=ele2026
TSE_AMBIENTE=oficial
# Tempo de cache compartilhado da rota /api/resultados, em segundos
CACHE_SEGUNDOS=20
# Tempo máximo de espera por arquivo do TSE, em milissegundos
TSE_TIMEOUT_MS=6000

# SOMENTE para testes locais (ignorado na Vercel): aponta para um servidor de dados simulados.
# PERMITIR_FONTE_TESTE=1
# TSE_BASE_URL=http://127.0.0.1:4010
